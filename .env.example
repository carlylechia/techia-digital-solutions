# ─── SME Outreach Engine ──────────────────────────────────────────────────────
# Every value below is server-side only. Never prefix any of these with
# NEXT_PUBLIC_ — they would be bundled into the browser.
#
# Global kill switch. Outreach email is refused unless this is exactly "true" AND
# NODE_ENV is "production". Leave it false while validating the pipeline.
OUTREACH_EMAIL_SEND_ENABLED=false

# Google Places API (New). Enable "Places API (New)" on the key and restrict it
# to the Places API plus your server IPs.
GOOGLE_MAPS_PLATFORM_API_KEY=

# Optional isolated outreach sending identity. Falls back to RESEND_API_KEY and
# RESEND_FROM_EMAIL when unset, so no new credential is strictly required.
# OUTREACH_RESEND_API_KEY=
# OUTREACH_FROM_EMAIL=
# OUTREACH_REPLY_TO=
# OUTREACH_SENDER_ADDRESS=

# Signing secret for the provider webhook (bounce, complaint, inbound reply).
# OUTREACH_WEBHOOK_SECRET=

# Model used for outreach assessment, email drafting and reply classification.
# OUTREACH_AI_MODEL=gpt-4o-mini

# Hard bounds. These cap what a campaign can ever request, so a misconfigured
# campaign cannot exceed them.
# OUTREACH_MAX_DAILY_DISCOVERY=200
# OUTREACH_MAX_DAILY_SEND=50
# OUTREACH_MAX_FOLLOW_UPS=2
# OUTREACH_MAX_DAILY_AI_ASSESS=100
# OUTREACH_MIN_HOURS_BETWEEN_SENDS=48
# OUTREACH_MAX_WEBSITE_BYTES=512000
# OUTREACH_MAX_AI_EVIDENCE_CHARS=6000
# OUTREACH_HTTP_TIMEOUT_MS=12000
# OUTREACH_WEBSITE_TIMEOUT_MS=12000
# OUTREACH_AI_TIMEOUT_MS=45000
# OUTREACH_JOB_LOCK_TIMEOUT_MINUTES=15
# OUTREACH_BOUNCE_RATE_ALERT=0.1
# OUTREACH_BOUNCE_RATE_ALERT_MIN_SENDS=20
