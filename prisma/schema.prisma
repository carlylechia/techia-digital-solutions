generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum LeadStatus {
  NEW
  CONTACTED
  DISCOVERY_BOOKED
  PROPOSAL_SENT
  NEGOTIATING
  WON
  LOST
  FOLLOW_UP_LATER
}

enum Locale {
  en
  fr
}

enum AdminStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum ClientStatus {
  PROSPECT
  ONBOARDING
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum ClientPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectStatus {
  PLANNED
  ACTIVE
  REVIEW
  ON_HOLD
  DELIVERED
  ARCHIVED
}

enum ContentStatus {
  DRAFT
  IN_REVIEW
  PUBLISHED
  ARCHIVED
}

enum BlogPostStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum ProcessStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum FeedbackStatus {
  PENDING
  APPROVED
  REJECTED
  ARCHIVED
}

enum CourseBonusClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  FULFILLED
  REJECTED
}

enum BonusDeliveryChannel {
  EMAIL
  WHATSAPP
}

enum BonusDeliveryPreference {
  EMAIL
  WHATSAPP
  BOTH
}

model Lead {
  id                String           @id @default(cuid())
  name              String
  email             String
  phone             String?
  whatsapp          String?
  company           String?
  country           String?
  preferredLanguage String?
  source            String           @default("website")
  status            LeadStatus       @default(NEW)
  notes             String?
  clientId          String?
  client            Client?          @relation("LeadClient", fields: [clientId], references: [id], onDelete: SetNull)
  inquiries         ProjectInquiry[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([clientId])
}

model ProjectInquiry {
  id                String   @id @default(cuid())
  leadId            String?
  lead              Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  businessType      String
  need              String
  budgetRange       String
  timeline          String
  details           String
  internalNotes     String?
  clientId          String?
  client            Client?  @relation("InquiryClient", fields: [clientId], references: [id], onDelete: SetNull)
  convertedToTaskId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([createdAt])
  @@index([clientId])
}

model ContactMessage {
  id        String     @id @default(cuid())
  name      String
  email     String
  phone     String?
  whatsapp  String?
  company   String?
  message   String
  locale    Locale?
  status    LeadStatus @default(NEW)
  notes     String?
  clientId  String?
  client    Client?    @relation("ContactMessageClient", fields: [clientId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([clientId])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    Locale?
  createdAt DateTime @default(now())
}

model CaseStudy {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  type        String
  content     Json
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model BlogPost {
  id                    String         @id @default(cuid())
  slug                  String
  title                 String
  excerpt               String
  content               String         @db.Text
  contentText           String         @default("") @db.Text
  locale                Locale         @default(en)
  published             Boolean        @default(true)
  status                BlogPostStatus @default(DRAFT)
  featured              Boolean        @default(false)
  showOnHomepage        Boolean        @default(false)
  homepageOrder         Int            @default(0)
  allowIndex            Boolean        @default(true)
  nofollow              Boolean        @default(false)
  seoTitle              String?
  seoDescription        String?
  focusKeyword          String?
  canonicalUrl          String?
  featuredImageUrl      String?
  featuredImagePublicId String?
  featuredImageAlt      String?
  ogImageUrl            String?
  ogImagePublicId       String?
  ctaTitle              String?
  ctaDescription        String?        @db.Text
  ctaHref               String?
  ctaLabel              String?
  readingTime           Int            @default(1)
  version               Int            @default(1)
  publishedAt           DateTime?
  scheduledAt           DateTime?
  submittedAt           DateTime?
  archivedAt            DateTime?
  authorId              String?
  categoryId            String?
  translationGroupId    String?
  createdById           String?
  lastEditedById        String?
  publishedById         String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  author           BlogAuthor?           @relation("BlogPostAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  category         BlogCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  translationGroup BlogTranslationGroup? @relation(fields: [translationGroupId], references: [id], onDelete: SetNull)
  createdBy        AdminUser?            @relation("BlogPostCreator", fields: [createdById], references: [id], onDelete: SetNull)
  lastEditedBy     AdminUser?            @relation("BlogPostEditor", fields: [lastEditedById], references: [id], onDelete: SetNull)
  publishedBy      AdminUser?            @relation("BlogPostPublisher", fields: [publishedById], references: [id], onDelete: SetNull)
  tags             BlogPostTag[]
  relatedFrom      BlogPostRelation[]    @relation("BlogRelatedFrom")
  relatedTo        BlogPostRelation[]    @relation("BlogRelatedTo")
  reviewNotes      BlogReviewNote[]
  revisions        BlogPostRevision[]
  slugRedirects    BlogSlugRedirect[]

  @@unique([locale, slug])
  @@index([locale, published])
  @@index([locale, status, publishedAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([authorId, status, updatedAt(sort: Desc)])
  @@index([createdById])
  @@index([lastEditedById])
  @@index([publishedById])
  @@index([categoryId, status, publishedAt(sort: Desc)])
  @@index([featured, status, publishedAt(sort: Desc)])
  @@index([locale, showOnHomepage, homepageOrder])
  @@index([scheduledAt, status])
  @@index([translationGroupId])
}

model BlogAuthor {
  id            String   @id @default(cuid())
  userId        String?  @unique
  displayName   String
  slug          String   @unique
  bio           String   @db.Text
  jobTitle      String?
  imageUrl      String?
  imagePublicId String?
  websiteUrl    String?
  linkedinUrl   String?
  xUrl          String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user  AdminUser? @relation("BlogAuthorUser", fields: [userId], references: [id], onDelete: SetNull)
  posts BlogPost[] @relation("BlogPostAuthor")

  @@index([isActive, displayName])
}

model BlogCategory {
  id             String   @id @default(cuid())
  name           String
  slug           String
  description    String?  @db.Text
  locale         Locale
  seoTitle       String?
  seoDescription String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  posts BlogPost[]

  @@unique([locale, slug])
  @@index([locale, isActive, name])
}

model BlogTag {
  id        String   @id @default(cuid())
  name      String
  slug      String
  locale    Locale
  createdAt DateTime @default(now())

  posts BlogPostTag[]

  @@unique([locale, slug])
  @@index([locale, name])
}

model BlogPostTag {
  postId String
  tagId  String
  post   BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    BlogTag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
}

model BlogTranslationGroup {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  posts BlogPost[]
}

model BlogPostRelation {
  fromPostId String
  toPostId   String
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  fromPost   BlogPost @relation("BlogRelatedFrom", fields: [fromPostId], references: [id], onDelete: Cascade)
  toPost     BlogPost @relation("BlogRelatedTo", fields: [toPostId], references: [id], onDelete: Cascade)

  @@id([fromPostId, toPostId])
  @@index([toPostId])
  @@index([fromPostId, sortOrder])
}

model BlogReviewNote {
  id        String     @id @default(cuid())
  postId    String
  authorId  String?
  body      String     @db.Text
  createdAt DateTime   @default(now())
  post      BlogPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    AdminUser? @relation("BlogReviewNoteAuthor", fields: [authorId], references: [id], onDelete: SetNull)

  @@index([postId, createdAt(sort: Desc)])
  @@index([authorId])
}

model BlogPostRevision {
  id                    String     @id @default(cuid())
  postId                String
  version               Int
  title                 String
  excerpt               String
  content               String     @db.Text
  seoTitle              String?
  seoDescription        String?
  featuredImageUrl      String?
  featuredImagePublicId String?
  featuredImageAlt      String?
  createdById           String?
  createdAt             DateTime   @default(now())
  post                  BlogPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdBy             AdminUser? @relation("BlogRevisionCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([postId, version])
  @@index([createdById])
  @@index([createdAt(sort: Desc)])
}

model BlogMedia {
  id           String     @id @default(cuid())
  publicId     String     @unique
  url          String
  resourceType String     @default("image")
  format       String
  mimeType     String
  width        Int?
  height       Int?
  bytes        Int
  altText      String     @default("")
  folder       String     @default("techia/blog")
  uploadedById String?
  createdAt    DateTime   @default(now())
  uploadedBy   AdminUser? @relation("BlogMediaUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([uploadedById, createdAt(sort: Desc)])
}

model BlogSlugRedirect {
  id         String    @id @default(cuid())
  locale     Locale
  slug       String
  targetSlug String
  postId     String?
  createdAt  DateTime  @default(now())
  post       BlogPost? @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([locale, slug])
  @@index([postId])
}

model Service {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  content     Json
  published   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Testimonial {
  id        String   @id @default(cuid())
  quote     String
  name      String
  role      String?
  company   String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
}

model DemoRequest {
  id                String     @id @default(cuid())
  name              String
  email             String
  phone             String?
  whatsapp          String?
  company           String?
  demo              String
  demoTitle         String?
  message           String?
  locale            Locale?
  status            LeadStatus @default(NEW)
  notes             String?
  clientId          String?
  client            Client?    @relation("DemoRequestClient", fields: [clientId], references: [id], onDelete: SetNull)
  country           String?
  preferredLanguage String     @default("en")
  businessType      String?
  projectNeed       String?
  budgetRange       String?
  timeline          String?
  source            String     @default("demo_lab")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([email])
  @@index([status])
  @@index([createdAt])
  @@index([clientId])
}

model AdminUser {
  id                    String                     @id @default(cuid())
  email                 String                     @unique
  name                  String?
  passwordHash          String?
  role                  String                     @default("admin")
  roleId                String?
  roleRef               AdminRole?                 @relation("RoleUsers", fields: [roleId], references: [id], onDelete: SetNull)
  status                AdminStatus                @default(ACTIVE)
  lastLoginAt           DateTime?
  createdById           String?
  createdBy             AdminUser?                 @relation("AdminCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAdmins         AdminUser[]                @relation("AdminCreator")
  createdRoles          AdminRole[]                @relation("RoleCreator")
  ownedClients          Client[]                   @relation("ClientOwner")
  assignedProjects      ClientProject[]            @relation("ProjectOwner")
  ownedBoards           ProcessBoard[]             @relation("BoardOwner")
  assignedTasks         ProcessTask[]              @relation("TaskAssignee")
  createdTasks          ProcessTask[]              @relation("TaskCreator")
  authoredPages         ContentPage[]              @relation("ContentAuthor")
  sentMessages          ConversationMessage[]      @relation("AdminSentMessages")
  portalAccesses        ClientPortalAccess[]
  portalMessages        PortalMessage[]
  portalReplies         PortalMessageReply[]
  portalFiles           PortalFile[]
  portalPayments        PortalPayment[]            @relation("PaymentCreatedBy")
  verifiedBonusClaims   CourseBonusClaim[]         @relation("VerifiedBonusClaims")
  fulfilledBonusClaims  CourseBonusClaim[]         @relation("FulfilledBonusClaims")
  courseBonusDeliveries CourseBonusClaimDelivery[] @relation("BonusDeliverySender")
  auditLogs             AuditLog[]
  blogAuthor            BlogAuthor?                @relation("BlogAuthorUser")
  blogPostsCreated      BlogPost[]                 @relation("BlogPostCreator")
  blogPostsEdited       BlogPost[]                 @relation("BlogPostEditor")
  blogPostsPublished    BlogPost[]                 @relation("BlogPostPublisher")
  blogMedia             BlogMedia[]                @relation("BlogMediaUploader")
  blogReviewNotes       BlogReviewNote[]           @relation("BlogReviewNoteAuthor")
  blogRevisions         BlogPostRevision[]         @relation("BlogRevisionCreator")
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt

  @@index([roleId])
  @@index([status])
}

model AdminRole {
  id          String      @id @default(cuid())
  name        String      @unique
  label       String
  description String?
  level       Int         @default(50)
  permissions String[]    @default([])
  users       AdminUser[] @relation("RoleUsers")
  createdById String?
  createdBy   AdminUser?  @relation("RoleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([level])
}

model Client {
  id                  String               @id @default(cuid())
  name                String
  slug                String               @unique
  industry            String?
  status              ClientStatus         @default(PROSPECT)
  priority            ClientPriority       @default(MEDIUM)
  contactName         String?
  contactRole         String?
  email               String?
  phone               String?
  whatsapp            String?
  website             String?
  country             String?
  city                String?
  estimatedValue      Int?
  preferredLocale     Locale               @default(en)
  source              String               @default("admin")
  sourceRequestId     String?
  sourceRequestType   String?
  tags                String[]             @default([])
  notes               String?
  ownerId             String?
  owner               AdminUser?           @relation("ClientOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contacts            ClientContact[]
  projects            ClientProject[]
  tasks               ProcessTask[]
  leads               Lead[]               @relation("LeadClient")
  contactMessages     ContactMessage[]     @relation("ContactMessageClient")
  demoRequests        DemoRequest[]        @relation("DemoRequestClient")
  inquiries           ProjectInquiry[]     @relation("InquiryClient")
  conversations       Conversation[]
  portalAccess        ClientPortalAccess?
  portalMessages      PortalMessage[]
  portalFiles         PortalFile[]
  portalInvoices      PortalInvoice[]
  portalRequirements  PortalRequirement[]
  portalNotifications PortalNotification[]
  portalPayments      PortalPayment[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@index([status, priority])
  @@index([ownerId])
  @@index([createdAt])
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  role      String?
  email     String?
  phone     String?
  isPrimary Boolean  @default(false)
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
  @@index([email])
}

model ClientProject {
  id                    String                 @id @default(cuid())
  clientId              String
  client                Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  ownerId               String?
  owner                 AdminUser?             @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  title                 String
  slug                  String
  status                ProjectStatus          @default(PLANNED)
  priority              ClientPriority         @default(MEDIUM)
  description           String?
  budget                Int?
  progress              Int                    @default(0)
  startDate             DateTime?
  dueDate               DateTime?
  completedAt           DateTime?
  showInPortfolio       Boolean                @default(false)
  showOnHomepage        Boolean                @default(false)
  showInFounder         Boolean                @default(false)
  publicOrder           Int                    @default(0)
  publicSlug            String?                @unique
  publicTitleEn         String?
  publicTitleFr         String?
  publicEyebrowEn       String?
  publicEyebrowFr       String?
  publicDescriptionEn   String?
  publicDescriptionFr   String?
  publicProblemEn       String?
  publicProblemFr       String?
  publicSolutionEn      String?
  publicSolutionFr      String?
  publicRoleEn          String?
  publicRoleFr          String?
  publicBusinessValueEn String?
  publicBusinessValueFr String?
  publicTechStack       String[]               @default([])
  feedbacks             CustomerFeedback[]
  portalFiles           PortalFile[]
  portalInvoices        PortalInvoice[]
  portalRequirements    PortalRequirement[]
  tasks                 ProcessTask[]
  portalPaymentProjects PortalPaymentProject[]
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt

  @@unique([clientId, slug])
  @@index([status, priority])
  @@index([ownerId])
  @@index([dueDate])
  @@index([showInPortfolio, publicOrder])
  @@index([showOnHomepage, publicOrder])
  @@index([showInFounder, publicOrder])
}

model CustomerFeedback {
  id              String         @id @default(cuid())
  projectId       String?
  project         ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name            String
  nameFr          String?
  role            String?
  roleFr          String?
  company         String?
  email           String?
  rating          Int?
  quote           String
  quoteFr         String?
  locale          Locale?
  source          String         @default("website")
  status          FeedbackStatus @default(PENDING)
  showOnHomepage  Boolean        @default(false)
  showOnFounder   Boolean        @default(false)
  showOnPortfolio Boolean        @default(false)
  displayOrder    Int            @default(0)
  consent         Boolean        @default(false)
  internalNotes   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([projectId])
  @@index([status, createdAt])
  @@index([showOnHomepage, displayOrder])
  @@index([showOnFounder, displayOrder])
  @@index([showOnPortfolio, displayOrder])
}

model CourseBonusClaim {
  id                String                     @id @default(cuid())
  locale            Locale?
  name              String
  email             String
  whatsapp          String?
  coursePackId      String
  coursePackTitle   String
  orderReference    String
  purchaseDate      DateTime?
  requestedBonusIds String[]                   @default([])
  proofNotes        String?
  proofUrl          String?
  proofPublicId     String?
  proofFileName     String?
  proofFileType     String?
  proofFileSize     Int?
  preferredDelivery BonusDeliveryPreference    @default(EMAIL)
  status            CourseBonusClaimStatus     @default(SUBMITTED)
  adminNotes        String?
  sourcePage        String?
  verifiedAt        DateTime?
  verifiedById      String?
  verifiedBy        AdminUser?                 @relation("VerifiedBonusClaims", fields: [verifiedById], references: [id], onDelete: SetNull)
  fulfilledAt       DateTime?
  fulfilledById     String?
  fulfilledBy       AdminUser?                 @relation("FulfilledBonusClaims", fields: [fulfilledById], references: [id], onDelete: SetNull)
  deliveries        CourseBonusClaimDelivery[]
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([coursePackId])
  @@index([verifiedById])
  @@index([fulfilledById])
}

model CourseBonusClaimDelivery {
  id       String               @id @default(cuid())
  claimId  String
  claim    CourseBonusClaim     @relation(fields: [claimId], references: [id], onDelete: Cascade)
  channel  BonusDeliveryChannel
  sentTo   String
  bonusIds String[]             @default([])
  subject  String?
  message  String?
  sentById String?
  sentBy   AdminUser?           @relation("BonusDeliverySender", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt   DateTime             @default(now())

  @@index([claimId, sentAt])
  @@index([sentById])
}

model HomepageFaq {
  id             String   @id @default(cuid())
  questionEn     String
  questionFr     String
  answerEn       String
  answerFr       String
  showOnHomepage Boolean  @default(true)
  displayOrder   Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([showOnHomepage, displayOrder])
}

model ContentPage {
  id             String               @id @default(cuid())
  slug           String               @unique
  type           String               @default("page")
  status         ContentStatus        @default(DRAFT)
  seoTitle       String?
  seoDescription String?
  sections       Json?
  publishedAt    DateTime?
  authorId       String?
  author         AdminUser?           @relation("ContentAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  translations   ContentTranslation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([status])
  @@index([type])
}

model NavMenuItem {
  id         String   @id @default(cuid())
  labelEn    String
  labelFr    String
  href       String
  visible    Boolean  @default(true)
  position   Int      @default(0)
  openNewTab Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([visible, position])
}

model ContentTranslation {
  id              String      @id @default(cuid())
  pageId          String
  page            ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  locale          Locale
  title           String
  excerpt         String?
  body            String
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@unique([pageId, locale])
  @@index([locale])
}

model ProcessBoard {
  id          String          @id @default(cuid())
  name        String
  description String?
  status      ProcessStatus   @default(ACTIVE)
  boardType   String?
  viewerRoles String[]        @default([])
  nextBoardId String?
  nextBoard   ProcessBoard?   @relation("BoardChain", fields: [nextBoardId], references: [id], onDelete: SetNull)
  prevBoards  ProcessBoard[]  @relation("BoardChain")
  ownerId     String?
  owner       AdminUser?      @relation("BoardOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  columns     ProcessColumn[]
  tasks       ProcessTask[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([status])
  @@index([ownerId])
  @@index([boardType])
}

model ProcessColumn {
  id        String        @id @default(cuid())
  boardId   String
  board     ProcessBoard  @relation(fields: [boardId], references: [id], onDelete: Cascade)
  key       String
  title     String
  color     String?
  position  Int           @default(0)
  tasks     ProcessTask[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([boardId, key])
  @@index([boardId, position])
}

model ProcessTask {
  id          String         @id @default(cuid())
  boardId     String
  board       ProcessBoard   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  columnId    String
  column      ProcessColumn  @relation(fields: [columnId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?        @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId   String?
  project     ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  requestType String?
  requestId   String?
  title       String
  description String?
  priority    ClientPriority @default(MEDIUM)
  position    Int            @default(0)
  dueDate     DateTime?
  tags        String[]       @default([])
  archived    Boolean        @default(false)
  assigneeId  String?
  assignee    AdminUser?     @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   AdminUser?     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([boardId, columnId, position])
  @@index([clientId])
  @@index([projectId])
  @@index([assigneeId])
  @@index([dueDate])
  @@index([archived])
  @@index([requestType, requestId])
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  actor      AdminUser? @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ip         String?
  createdAt  DateTime   @default(now())

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Conversation {
  id          String                @id @default(cuid())
  requestType String
  requestId   String
  clientId    String?
  client      Client?               @relation(fields: [clientId], references: [id], onDelete: SetNull)
  subject     String
  messages    ConversationMessage[]
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([requestType, requestId])
  @@index([clientId])
}

model ConversationMessage {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  channel        String
  direction      String       @default("outbound")
  from           String
  to             String
  subject        String?
  body           String
  sentById       String?
  sentBy         AdminUser?   @relation("AdminSentMessages", fields: [sentById], references: [id], onDelete: SetNull)
  sentAt         DateTime     @default(now())

  @@index([conversationId])
  @@index([sentById])
}

// ─── Client Portal Models ─────────────────────────────────────────

model ClientPortalAccess {
  id          String     @id @default(cuid())
  clientId    String     @unique
  client      Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  code        String     @unique
  isActive    Boolean    @default(true)
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdById String?
  createdBy   AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([code])
  @@index([clientId])
}

model PortalMessage {
  id        String               @id @default(cuid())
  clientId  String
  client    Client               @relation(fields: [clientId], references: [id], onDelete: Cascade)
  subject   String
  body      String
  fromAdmin Boolean              @default(true)
  adminId   String?
  admin     AdminUser?           @relation(fields: [adminId], references: [id], onDelete: SetNull)
  readAt    DateTime?
  replies   PortalMessageReply[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([clientId])
  @@index([adminId])
  @@index([createdAt])
}

model PortalMessageReply {
  id        String        @id @default(cuid())
  messageId String
  message   PortalMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  body      String
  fromAdmin Boolean       @default(false)
  adminId   String?
  admin     AdminUser?    @relation(fields: [adminId], references: [id], onDelete: SetNull)
  readAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([messageId])
}

model PortalFile {
  id         String         @id @default(cuid())
  clientId   String
  client     Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId  String?
  project    ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  name       String
  fileType   String
  category   String         @default("deliverable")
  url        String
  publicId   String?
  size       Int?
  uploadedBy String         @default("admin")
  adminId    String?
  admin      AdminUser?     @relation(fields: [adminId], references: [id], onDelete: SetNull)
  status     String         @default("available")
  notes      String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([adminId])
  @@index([category])
}

model PortalInvoice {
  id                 String         @id @default(cuid())
  clientId           String
  client             Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId          String?
  project            ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  paymentId          String?
  payment            PortalPayment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  invoiceNumber      String
  title              String
  amount             Int
  currency           String         @default("USD")
  // DRAFT | SENT | AWAITING_CONFIRMATION | PAID | OVERDUE | CANCELLED
  status             String         @default("DRAFT")
  dueDate            DateTime?
  paidAt             DateTime?
  confirmedAt        DateTime?
  confirmedById      String?
  notes              String?
  lineItems          Json?
  proofOfPaymentUrl  String?
  proofOfPaymentName String?
  proofRequired      Boolean        @default(false)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

model PortalPayment {
  id             String                 @id @default(cuid())
  clientId       String
  client         Client                 @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  description    String?
  totalAmount    Int
  initialPayment Int                    @default(0)
  currency       String                 @default("USD")
  // ACTIVE | COMPLETED | CANCELLED
  status         String                 @default("ACTIVE")
  notes          String?
  projects       PortalPaymentProject[]
  invoices       PortalInvoice[]
  createdById    String?
  createdBy      AdminUser?             @relation("PaymentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model PortalPaymentProject {
  paymentId String
  projectId String
  payment   PortalPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  project   ClientProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([paymentId, projectId])
  @@index([paymentId])
  @@index([projectId])
}

model PortalRequirement {
  id           String         @id @default(cuid())
  clientId     String
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId    String?
  project      ClientProject? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title        String
  description  String?
  type         String         @default("file")
  status       String         @default("PENDING")
  dueDate      DateTime?
  submittedAt  DateTime?
  response     String?
  fileUrl      String?
  filePublicId String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([status])
}

model PortalNotification {
  id        String    @id @default(cuid())
  clientId  String
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String?
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([clientId])
  @@index([readAt])
  @@index([createdAt])
}

model AIConversation {
  id           String      @id @default(cuid())
  sessionId    String
  userId       String?
  visitorName  String?
  visitorEmail String?
  visitorPhone String?
  sourcePage   String?
  status       String      @default("ACTIVE")
  messageCount Int         @default(0)
  totalTokens  Int         @default(0)
  summary      String?
  messages     AIMessage[]
  usageRecords AIUsage[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([sessionId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

model AILead {
  id              String   @id @default(cuid())
  name            String?
  email           String?
  phone           String?
  companyName     String?
  industry        String?
  serviceInterest String
  budgetRange     String?
  timeline        String?
  projectSummary  String
  leadScore       String
  status          String   @default("NEW")
  source          String   @default("AI_AGENT")
  conversationId  String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([leadScore])
  @@index([status])
  @@index([source])
  @@index([createdAt])
  @@index([serviceInterest])
}

model AIDemoRequest {
  id                     String    @id @default(cuid())
  aiLeadId               String?
  demoType               String
  name                   String?
  email                  String?
  phone                  String?
  companyName            String?
  preferredDate          DateTime?
  preferredContactMethod String?
  notes                  String?
  status                 String    @default("NEW")
  conversationId         String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status])
  @@index([demoType])
  @@index([createdAt])
  @@index([aiLeadId])
}

model AIUsage {
  id             String          @id @default(cuid())
  ipHash         String?
  sessionId      String?
  userId         String?
  conversationId String?
  conversation   AIConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  model          String
  inputTokens    Int             @default(0)
  outputTokens   Int             @default(0)
  totalTokens    Int             @default(0)
  estimatedCost  Float           @default(0)
  requestType    String          @default("PUBLIC_AGENT")
  createdAt      DateTime        @default(now())

  @@index([ipHash])
  @@index([sessionId])
  @@index([userId])
  @@index([conversationId])
  @@index([createdAt])
  @@index([requestType])
}

model AIAbuseEvent {
  id        String   @id @default(cuid())
  ipHash    String?
  sessionId String?
  reason    String
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([ipHash])
  @@index([sessionId])
  @@index([reason])
  @@index([createdAt])
}
